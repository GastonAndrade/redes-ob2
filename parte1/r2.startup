ip route add 10.100.0.20/30 via 10.100.0.13
ip route add 10.100.0.32/30 via 10.100.0.30
ip route add 10.100.0.36/30 via 10.100.0.26
ip route add 10.100.0.40/30 via 10.100.0.18
ip route add 203.0.113.0/29 via 10.100.0.30
ip route add 203.0.113.8/30 via 10.100.0.26
