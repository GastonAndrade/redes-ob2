# --- IPs de cada interfaz ---

ip addr add 203.0.113.2/30 dev eth0
ip addr add 10.27.0.1/16 dev eth1
ip addr add 203.0.113.5/30 dev eth2

# --- Rutas lejanas ---

ip route add 0.0.0.0/0 via 203.0.113.1

# --- LA NAT ---

iptables -t nat -A POSTROUTING -s 10.27.0.0/16 -o eth0 -j SNAT --to-source 203.0.113.2
