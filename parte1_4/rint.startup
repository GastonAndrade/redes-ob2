# --- IPs de cada interfaz ---

ip addr add 8.8.8.1/24 dev eth0
ip addr add 10.100.0.1/30 dev eth1
ip addr add 10.100.0.5/30 dev eth2

# --- Rutas lejanas ---

ip route add 203.0.113.0/29 via 10.100.0.6 metric 10
ip route add 203.0.113.0/29 via 10.100.0.2 metric 20
ip route add 203.0.113.8/30 via 10.100.0.2 metric 10
ip route add 203.0.113.8/30 via 10.100.0.6 metric 20
ip route add 203.0.113.16/30 via 10.100.0.6 metric 10
ip route add 203.0.113.16/30 via 10.100.0.2 metric 20
ip route add 10.100.0.0/16 via 10.100.0.2 metric 10
ip route add 10.100.0.0/16 via 10.100.0.6 metric 20