# --- IPs de cada interfaz ---

ip addr add 192.168.27.6/30 dev eth0
ip addr add 10.27.0.1/16 dev eth1
ip addr add 203.0.113.1/30 dev eth2

# --- Rutas lejanas ---

ip route add 0.0.0.0/0 via 192.168.27.5
ip route add 192.168.27.0/30 via 192.168.27.5

# --- LA NAT ---

iptables -t nat -A POSTROUTING -s 10.27.0.0/16 -o eth0 -j SNAT --to-source 192.168.27.6
