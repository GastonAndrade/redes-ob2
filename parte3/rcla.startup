# --- IPs de cada interfaz ---

ip link set dev eth1 down
ip link set dev eth2 down
ip link set dev eth3 down
ip link set dev eth4 down
ip link set dev eth1 address 00:00:00:00:00:0b
ip link set dev eth2 address 00:00:00:00:00:0c
ip link set dev eth3 address 00:00:00:00:00:0d
ip link set dev eth4 address 00:00:00:00:00:0e
ip link set dev eth1 up
ip link set dev eth2 up
ip link set dev eth3 up
ip link set dev eth4 up
ip addr add 203.0.113.10/30 dev eth0
ip addr add 10.27.0.1/26 dev eth1
ip addr add 10.27.0.129/25 dev eth2
ip addr add 10.27.2.1/23 dev eth3
ip addr add 203.0.113.33/27 dev eth4

# --- Rutas lejanas ---

ip route add 0.0.0.0/0 via 203.0.113.9

# --- LA NAT ---

iptables -t nat -A POSTROUTING -s 10.27.0.0/16 -o eth0 -j SNAT --to-source 203.0.113.10
